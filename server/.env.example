# Railway: reference the Postgres plugin's variable -> DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/choicedelivery
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
# Optional: lets a website/order form create pickups via POST /pickups with "Authorization: Bearer <key>"
DISPATCH_API_KEY=
# Optional: password-reset emails via https://resend.com (otherwise links are logged)
RESEND_API_KEY=
MAIL_FROM=Choice Delivery <no-reply@choicedeliverysc.com>
# Optional: public URL used in reset-password links (defaults to the request host)
PUBLIC_URL=
