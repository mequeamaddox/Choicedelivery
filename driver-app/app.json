{
  "expo": {
    "name": "Choice Delivery Driver",
    "slug": "choicedelivery",
    "scheme": "choicedriver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.choicedeliverysc.driver",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.choicedeliverysc.driver",
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0F766E"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Choice Delivery uses your location to show dispatch and customers where their delivery is while you're online.",
          "locationAlwaysAndWhenInUsePermission": "Choice Delivery keeps sharing your location while you're online, even with the app in the background, so customers can track their delivery. Go offline to stop.",
          "locationAlwaysPermission": "Choice Delivery keeps sharing your location while you're online so customers can track their delivery. Go offline to stop.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F766E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Choice Delivery uses the camera to scan package barcodes and take proof-of-delivery photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Choice Delivery uses the camera to take proof-of-pickup and delivery photos.",
          "photosPermission": "Choice Delivery lets you pick your profile photo and document photos from your library.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://app.choicedeliverysc.com",
      "eas": {
        "projectId": "455a933b-8b61-40ec-a9df-c1caa9417b05"
      }
    }
  }
}
